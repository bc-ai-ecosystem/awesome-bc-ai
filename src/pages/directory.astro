---
import Layout from '../layouts/Layout.astro';
import ProjectSearch from '../components/ProjectSearch';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Directory" description="Explore the projects, tools, datasets and archives built by the BC + AI community.">
	<div class="mb-10">
		<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-chartreuse-ink mb-3">Awesome BC + AI</p>
		<h1 class="font-display font-black text-4xl md:text-6xl tracking-tight mb-4">Ecosystem Directory</h1>
		<p class="text-lg text-ink-soft max-w-3xl leading-relaxed">
			Everything the community has shipped and shared: projects, tools, datasets, books and archives.
			Filter by field, search, or browse the timeline.
		</p>
	</div>

	<ProjectSearch client:load projects={projects} />
</Layout>
