---
import Layout from '../../layouts/Layout.astro';
import ProjectSearch from '../../components/ProjectSearch';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const events = new Set(projects.map(p => p.data.event).filter(Boolean));

  return Array.from(events).map(event => ({
    params: { event },
    props: { eventProjects: projects.filter(p => p.data.event === event) },
  }));
}

const { event } = Astro.params;
const { eventProjects } = Astro.props;
---

<Layout title={`${event} Projects`}>
	<div class="mb-10">
    <a href={`${import.meta.env.BASE_URL}directory`} class="text-sm font-medium text-ink-soft hover:text-ink transition-colors">&larr; Back to Directory</a>
    <div class="mt-5">
      <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] rounded-full bg-cat-hack/15 text-cat-hack border border-cat-hack/40 mb-4">Event Roster</span>
      <h1 class="font-display font-black text-4xl md:text-6xl tracking-tight mb-4">{event}</h1>
      <p class="text-lg text-ink-soft max-w-3xl leading-relaxed">
        Projects created and submitted during this event.
      </p>
    </div>
	</div>

	<ProjectSearch client:load projects={eventProjects} />
</Layout>
